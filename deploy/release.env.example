# Provider-neutral release input example.
# Copy outside the repository, replace placeholders with approved environment values,
# and keep real credentials/secrets out of source control.

CHARKHOONE_API_IMAGE=registry.example.test/charkhoone/api@sha256:<immutable-digest>
CHARKHOONE_WORKER_IMAGE=registry.example.test/charkhoone/worker@sha256:<immutable-digest>
CHARKHOONE_WEB_IMAGE=registry.example.test/charkhoone/web@sha256:<immutable-digest>
CHARKHOONE_RELEASE_SHA=<40-character-git-sha>
CHARKHOONE_ENVIRONMENT=Staging

CHARKHOONE_POSTGRES_CONNECTION=<secret-runtime-postgres-connection>
CHARKHOONE_AUTHORITY=https://identity.example.test/realms/charkhoone
CHARKHOONE_AUDIENCE=charkhoone-api
CHARKHOONE_ADMIN_OIDC_LOGIN_URL=https://identity.example.test/admin/login

CHARKHOONE_RABBITMQ_HOST=rabbitmq.example.internal
CHARKHOONE_RABBITMQ_PORT=5672
CHARKHOONE_RABBITMQ_USERNAME=<secret-runtime-username>
CHARKHOONE_RABBITMQ_PASSWORD=<secret-runtime-password>
CHARKHOONE_RABBITMQ_VHOST=/

# Pilot operations fail closed by default. When enabled, at least one exact OIDC
# subject must be supplied or the API refuses to start.
CHARKHOONE_PILOT_OPERATIONS_ENABLED=false
CHARKHOONE_PILOT_OPERATOR_SUBJECT_0=
CHARKHOONE_PILOT_OPERATOR_SUBJECT_1=
CHARKHOONE_PILOT_OPERATOR_SUBJECT_2=
CHARKHOONE_PILOT_OPERATOR_SUBJECT_3=

CHARKHOONE_FINANCIAL_RECONCILIATION_ENABLED=false
CHARKHOONE_OTLP_ENDPOINT=
CHARKHOONE_HTTP_BIND=127.0.0.1:8080
