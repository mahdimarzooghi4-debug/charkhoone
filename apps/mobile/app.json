{
  "expo": {
    "name": "چارخونه",
    "slug": "charkhoone",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "charkhoone",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "android": {
      "package": "ir.charkhoone.app",
      "icon": "./assets/charkhoone-app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/charkhoone-adaptive-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/charkhoone-app-icon.png",
      "name": "چارخونه",
      "shortName": "چارخونه",
      "lang": "fa",
      "dir": "rtl",
      "display": "standalone",
      "startUrl": "/",
      "themeColor": "#0D3B36",
      "backgroundColor": "#0D3B36",
      "orientation": "portrait"
    },
    "icon": "./assets/charkhoone-app-icon.png",
    "ios": {
      "icon": "./assets/charkhoone-app-icon.png"
    }
  }
}
